<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aure_widget_fondo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <TextView
        android:id="@+id/w_hablar"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/aure_widget_boton_oro"
        android:gravity="center"
        android:maxLines="2"
        android:padding="4dp"
        android:text="Hablar"
        android:textColor="#0E0E10"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_bienvenida"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/aure_widget_boton"
        android:gravity="center"
        android:maxLines="2"
        android:padding="4dp"
        android:text="Llego a casa"
        android:textColor="#F1DDB2"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/w_cena"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/aure_widget_boton"
        android:gravity="center"
        android:maxLines="2"
        android:padding="4dp"
        android:text="Modo cena"
        android:textColor="#F1DDB2"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/w_noches"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/aure_widget_boton"
        android:gravity="center"
        android:maxLines="2"
        android:padding="4dp"
        android:text="Buenas noches"
        android:textColor="#F1DDB2"
        android:textSize="13sp" />
</LinearLayout>
